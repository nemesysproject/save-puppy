{
  "name": "save-puppy",
  "version": "1.0.0",
  "description": "api cqrs para antender app móvil y plataforma web",
  "keywords": [
    "puppies",
    "cats",
    "others"
  ],
  "license": "ISC",
  "author": "zutm",
  "type": "commonjs",
  "main": "index.ts",
  "scripts": {
    "test": "test-api",
    "prestart": "npm run build",
    "start": "prisma migrate deploy && prisma db seed && node dist/index.js",
    "dev": "nodemon -r tsconfig-paths/register src/index.ts",
    "build": "prisma generate && tsc && tsc-alias",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "amqplib": "^0.10.9",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.9.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "multer": "^2.0.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.10.4",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^9.0.7",
    "nodemon": "^1.0.2",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.8",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "prisma": {
    "seed": "node -r ts-node/register prisma/seed.ts"
  }
}
