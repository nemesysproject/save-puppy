// Generador del cliente de Prisma (ORM)
generator client {
  provider = "prisma-client-js"
}

// Conexión a PostgreSQL
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modelo de Dominio para Escritura (Commands)
// Solo guardamos lo esencial para la integridad transaccional
model Pet {
  id         String   @id @default(uuid())
  name       String
  type       String // DOG, CAT, etc.
  status     String // LOST, ADOPTION, FOUND
  ownerEmail String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Aquí podrías agregar relaciones con tablas de donaciones o refugios
  // donations Donation[]
}
