// Generador del cliente de Prisma (ORM)
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

// Conexión a PostgreSQL
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modelo de Seguridad y Autenticación Centralizada
model User {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String? // Hashed para Local, Null para Social
  role       String // ADMIN, ADOPTER, SHELTER
  provider   String // LOCAL, GOOGLE, FACEBOOK
  providerId String? // ID retornado por Google/Facebook
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  owner   Owner?
  shelter Shelter?
}

// Modelo de Dominio para Escritura (Commands)
// Solo guardamos lo esencial para la integridad transaccional
model Pet {
  id         String   @id @default(uuid())
  name       String
  status     String // LOST, ADOPTION, FOUND
  ownerEmail String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  kindId String
  kind   Kind   @relation(fields: [kindId], references: [id])

  genderId String
  gender   Gender @relation(fields: [genderId], references: [id])

  shelterId String?
  shelter   Shelter?   @relation(fields: [shelterId], references: [id])
  media     Media[]
  adoptions Adoption[]
}

model Media {
  id         String  @id @default(uuid())
  url        String // URL pública del recurso (CDN/Bucket)
  storageKey String? // Identificador interno en el proveedor (para borrar/actualizar)
  provider   String? // Ej: AWS_S3, CLOUDINARY, FIREBASE
  type       String // IMAGE, VIDEO

  // Ubicación geoespacial de la evidencia (donde se tomó la foto/video)
  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  petId String
  pet   Pet    @relation(fields: [petId], references: [id])
}

model Shelter {
  id        String   @id @default(uuid())
  name      String
  address   String?
  latitude  Float?
  longitude Float?
  email     String   @unique
  phone     String?
  website   String?
  capacity  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relación con la cuenta de usuario (Login)
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  pets      Pet[]
  adoptions Adoption[]
}

model Owner {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String   @unique
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relación con la cuenta de usuario (Login)
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  adoptions Adoption[]
}

model Adoption {
  id     String   @id @default(uuid())
  date   DateTime @default(now())
  status String // PENDING, APPROVED, REJECTED
  notes  String?

  petId String
  pet   Pet    @relation(fields: [petId], references: [id])

  ownerId String
  owner   Owner  @relation(fields: [ownerId], references: [id])

  shelterId String?
  shelter   Shelter? @relation(fields: [shelterId], references: [id])
}

model Kind {
  id        String   @id @default(uuid())
  name      String   @unique // DOG, CAT, BIRD
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pets      Pet[]
}

model Gender {
  id        String   @id @default(uuid())
  name      String   @unique // MALE, FEMALE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pets      Pet[]
}
