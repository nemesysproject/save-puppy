		"@angular/platform-browser": "^21.2.4",
		"@angular/router": "^21.2.4",
		"@angular/service-worker": "^21.2.4",
		"@capacitor-community/sqlite": "^8.0.1",
		"@capacitor/android": "^8.1.0",
		"@capacitor/camera": "^8.0.2",
		"@capacitor/cli": "^2.5.0",
